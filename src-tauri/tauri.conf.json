{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/HEAD/tauri.conf.json",
  "productName": "PromptBox v2",
  "version": "2.0.0",
  "identifier": "com.promptbox.v2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PromptBox v2",
        "width": 1200,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
